NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:4200
DATABASE_URL=postgresql://planner_app:LOCAL_ONLY_CHANGE_ME@localhost:55432/planner
MIGRATION_DATABASE_URL=postgresql://postgres:LOCAL_ONLY_CHANGE_ME@localhost:55432/planner
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY_HOPS=0
# Trusted server-side Python 3.11+ executable; default is python on PATH.
FORECAST_PYTHON=python
# Optional M7 assistance; manual functionality remains complete when disabled.
AI_ENABLED=false
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=20000
