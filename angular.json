{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "web": {
      "projectType": "application",
      "root": "apps/web",
      "sourceRoot": "apps/web/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web",
            "index": "apps/web/src/index.html",
            "browser": "apps/web/src/main.ts",
            "tsConfig": "apps/web/tsconfig.app.json",
            "styles": [
              "apps/web/src/styles.css",
              "apps/web/src/ui-system.css",
              "apps/web/src/refinement.css",
              "apps/web/src/premium.css",
              "apps/web/src/product-system.css",
              "apps/web/src/overview-prototype.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/web/public",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "web:build",
            "host": "localhost",
            "port": 4200
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
