{
  "name": "financial-planning-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx --env-file=.env apps/api/src/server.ts",
    "web": "ng serve web --proxy-config apps/web/proxy.json",
    "build": "npm run build:api && ng build web",
    "build:api": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && ngc -p apps/web/tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/contracts.test.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "21.2.23",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "7.0.2",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "fast-xml-parser": "5.11.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "yauzl": "3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "3.4.0",
    "embedded-postgres": "^18.0.0-beta.15",
    "eslint": "^9.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
